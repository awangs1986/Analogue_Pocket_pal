From acc7a24d2a11bc0ad139e97c469007e5488a9e92 Mon Sep 17 00:00:00 2001
From: tc-local <tc@localhost>
Date: Fri, 9 Oct 2026 04:49:01 +0800
Subject: [PATCH 1/4] TC-1a io_sdram: registered one-hot dq selects for
 phy_dq_out (bit-exact, lockstep-sim verified)

---
 src/fpga/targets/pocket/io_sdram.v | 158 +++++++++++++++++------------
 1 file changed, 91 insertions(+), 67 deletions(-)

diff --git a/src/fpga/targets/pocket/io_sdram.v b/src/fpga/targets/pocket/io_sdram.v
index 5f866ee..95aa164 100644
--- a/src/fpga/targets/pocket/io_sdram.v
+++ b/src/fpga/targets/pocket/io_sdram.v
@@ -116,6 +116,10 @@ assign {phy_ras, phy_cas, phy_we} = cmd;
     localparam      TIMING_WRITE        =   4'd2;   // tWR = 2ck
 
     reg     [5:0]   state;
+    reg     [5:0]   state_nx;            // TC-1 blocking next-state temp
+    reg             dq_sel_w2  = 1'b0;  // TC-1: == (state == ST_WRITE_2)
+    reg             dq_sel_w3  = 1'b0;  // TC-1: == (state == ST_WRITE_3)
+    reg             dq_sel_bw3 = 1'b0;  // TC-1: == (state == ST_BURSTWR_3)
 
     localparam      ST_RESET            = 'd0;
     localparam      ST_BOOT_0           = 'd1;
@@ -360,6 +364,11 @@ initial begin
     phy_cke <= 0;
 end
 always @(posedge controller_clk) begin
+    // TC-1: state_nx is the blocking next-state temp; state and the
+    // registered one-hot write-data selects below are both loaded from it,
+    // so dq_sel_* == (state == ST_x) in every cycle (bit-exact with the
+    // original in-case phy_dq_out loads).
+    state_nx = state;
     phy_dq_oe <= 0;
     cmd <= CMD_NOP;
     // Default DQM low (no mask) every cycle.  This makes phy_dqm a clean
@@ -437,7 +446,7 @@ always @(posedge controller_clk) begin
         refresh_pending <= 3'd0;
         phy_dqm <= 2'b00;
 
-        state <= ST_BOOT_0;
+        state_nx = ST_BOOT_0;
     end
     ST_BOOT_0: begin
         delay_boot <= delay_boot + 1'b1;
@@ -451,7 +460,7 @@ always @(posedge controller_clk) begin
             cmd <= CMD_PRECHG;
             phy_a[10] <= 1'b1;
 
-            state <= ST_BOOT_1;
+            state_nx = ST_BOOT_1;
         end
     end
     ST_BOOT_1: begin
@@ -459,7 +468,7 @@ always @(posedge controller_clk) begin
             dc <= 0;
             cmd <= CMD_AUTOREF;
 
-            state <= ST_BOOT_2;
+            state_nx = ST_BOOT_2;
         end
     end
     ST_BOOT_2: begin
@@ -467,7 +476,7 @@ always @(posedge controller_clk) begin
             dc <= 0;
             cmd <= CMD_AUTOREF;
 
-            state <= ST_BOOT_3;
+            state_nx = ST_BOOT_3;
         end
     end
     ST_BOOT_3: begin
@@ -477,7 +486,7 @@ always @(posedge controller_clk) begin
             phy_ba <= 'b00;
             phy_a <= 13'b000000_011_0_001; // CAS 3, burst length 2, sequential
 
-            state <= ST_BOOT_4;
+            state_nx = ST_BOOT_4;
         end
     end
     ST_BOOT_4: begin
@@ -487,14 +496,14 @@ always @(posedge controller_clk) begin
             phy_ba <= 'b10; // Extended mode register
             phy_a <= 13'b00000_010_00_000; // Self refresh coverage: All banks,
             // drive strength = 3'b010 (alliance, 50%)
-            state <= ST_BOOT_5;
+            state_nx = ST_BOOT_5;
         end
     end
     ST_BOOT_5: begin
         if(dc == TIMING_LMR-1) begin
             phy_dqm <= 2'b00;
 
-            state <= ST_IDLE;
+            state_nx = ST_IDLE;
         end
     end
 
@@ -517,9 +526,9 @@ always @(posedge controller_clk) begin
                 phy_a[10] <= 1'b1;
                 row_open_v <= 4'd0;
                 prechg_return <= 2'd3;  // 3 = refresh
-                state <= ST_PRECHG_WAIT;
+                state_nx = ST_PRECHG_WAIT;
             end else begin
-                state <= ST_REFRESH_0;
+                state_nx = ST_REFRESH_0;
             end
         end else
         // Video scanout fetch is hard-real-time: it must deliver one line of
@@ -577,7 +586,7 @@ always @(posedge controller_clk) begin
             // ACTivated while another bank's row is open.
             req_prechg_bank <= (BANK_ROW_TRACK != 0) ? burst_addr[24:23]
                                                      : open_bank;
-            state <= ST_REQ_BURST_READ;
+            state_nx = ST_REQ_BURST_READ;
         end else
         if(word_rd_queue) begin
             word_rd_queue <= 0;
@@ -593,7 +602,7 @@ always @(posedge controller_clk) begin
             req_bank <= pending_bank;
             req_prechg_bank <= (BANK_ROW_TRACK != 0) ? pending_bank
                                                      : open_bank;
-            state <= ST_REQ_READ;
+            state_nx = ST_REQ_READ;
         end else
         if(word_wr_queue) begin
             word_wr_queue <= 0;
@@ -609,7 +618,7 @@ always @(posedge controller_clk) begin
             req_bank <= pending_bank;
             req_prechg_bank <= (BANK_ROW_TRACK != 0) ? pending_bank
                                                      : open_bank;
-            state <= ST_REQ_WRITE;
+            state_nx = ST_REQ_WRITE;
         end else
         if(burstwr_queue) begin
             burstwr_queue <= 0;
@@ -619,7 +628,7 @@ always @(posedge controller_clk) begin
             req_need_prechg <= row_open_v[trk(burstwr_addr[24:23])];
             req_prechg_bank <= (BANK_ROW_TRACK != 0) ? burstwr_addr[24:23]
                                                      : open_bank;
-            state <= ST_REQ_BURST_WRITE;
+            state_nx = ST_REQ_BURST_WRITE;
         end
 
     end
@@ -632,7 +641,7 @@ always @(posedge controller_clk) begin
             // ROW HIT: skip ACT+tRCD, go directly to READ
             phy_ba <= req_bank;
             enable_dq_read_toggle <= 0;
-            state <= ST_READ_2;
+            state_nx = ST_READ_2;
         end else if(req_need_prechg) begin
             // ROW MISS or DIFFERENT BANK: precharge, then ACT
             dc <= 0;
@@ -641,10 +650,10 @@ always @(posedge controller_clk) begin
             phy_a[10] <= 1'b0;
             row_open_v[trk(req_prechg_bank)] <= 1'b0;
             prechg_return <= 2'd0;
-            state <= ST_PRECHG_WAIT;
+            state_nx = ST_PRECHG_WAIT;
         end else begin
             // NO ROW OPEN: normal ACT path
-            state <= ST_READ_0;
+            state_nx = ST_READ_0;
         end
     end
 
@@ -652,7 +661,7 @@ always @(posedge controller_clk) begin
         if(req_row_hit) begin
             // ROW HIT: 1-cycle DQ setup, then WRITE
             phy_ba <= req_bank;
-            state <= ST_WRITE_HIT;
+            state_nx = ST_WRITE_HIT;
         end else if(req_need_prechg) begin
             // ROW MISS or DIFFERENT BANK: precharge, then ACT
             dc <= 0;
@@ -661,10 +670,10 @@ always @(posedge controller_clk) begin
             phy_a[10] <= 1'b0;
             row_open_v[trk(req_prechg_bank)] <= 1'b0;
             prechg_return <= 2'd1;
-            state <= ST_PRECHG_WAIT;
+            state_nx = ST_PRECHG_WAIT;
         end else begin
             // NO ROW OPEN: normal ACT path
-            state <= ST_WRITE_0;
+            state_nx = ST_WRITE_0;
         end
     end
 
@@ -673,7 +682,7 @@ always @(posedge controller_clk) begin
             // ROW HIT: skip precharge+ACT, go directly to READ
             phy_ba <= req_bank;
             enable_dq_read_toggle <= 0;
-            state <= ST_READ_2;
+            state_nx = ST_READ_2;
         end else if(req_need_prechg) begin
             // ROW MISS: precharge open bank, then ACT
             dc <= 0;
@@ -682,10 +691,10 @@ always @(posedge controller_clk) begin
             phy_a[10] <= 1'b0;
             row_open_v[trk(req_prechg_bank)] <= 1'b0;
             prechg_return <= 2'd0;
-            state <= ST_PRECHG_WAIT;
+            state_nx = ST_PRECHG_WAIT;
         end else begin
             // NO ROW OPEN: normal ACT path
-            state <= ST_READ_0;
+            state_nx = ST_READ_0;
         end
     end
 
@@ -698,9 +707,9 @@ always @(posedge controller_clk) begin
             phy_a[10] <= 1'b0;
             row_open_v[trk(req_prechg_bank)] <= 1'b0;
             prechg_return <= 2'd2;
-            state <= ST_PRECHG_WAIT;
+            state_nx = ST_PRECHG_WAIT;
         end else begin
-            state <= ST_BURSTWR_0;
+            state_nx = ST_BURSTWR_0;
         end
     end
 
@@ -711,17 +720,17 @@ always @(posedge controller_clk) begin
             case(prechg_return)
                 2'd0: begin
                     phy_ba <= req_bank;
-                    state <= ST_READ_0;
+                    state_nx = ST_READ_0;
                 end
                 2'd1: begin
                     phy_ba <= req_bank;
-                    state <= ST_WRITE_0;
+                    state_nx = ST_WRITE_0;
                 end
                 2'd2: begin
                     phy_ba <= addr[24:23];
-                    state <= ST_BURSTWR_0;
+                    state_nx = ST_BURSTWR_0;
                 end
-                2'd3: state <= ST_REFRESH_0;
+                2'd3: state_nx = ST_REFRESH_0;
             endcase
         end
     end
@@ -730,7 +739,7 @@ always @(posedge controller_clk) begin
     ST_WRITE_HIT: begin
         phy_a[10] <= 1'b0;
         phy_dq_oe <= 1;
-        state <= ST_WRITE_2;
+        state_nx = ST_WRITE_2;
     end
 
 
@@ -748,14 +757,14 @@ always @(posedge controller_clk) begin
         open_row[trk(addr[24:23])] <= addr[22:10];
         open_bank <= addr[24:23];
 
-        state <= ST_WRITE_1;
+        state_nx = ST_WRITE_1;
     end
     ST_WRITE_1: begin
         phy_a[10] <= 1'b0; // no auto precharge
         if(dc == TIMING_ACT_RW-1) begin
             dc <= 0;
             phy_dq_oe <= 1;
-            state <= ST_WRITE_2;
+            state_nx = ST_WRITE_2;
         end
     end
     ST_WRITE_2: begin
@@ -764,7 +773,7 @@ always @(posedge controller_clk) begin
         phy_a <= addr[9:0];
         cmd <= CMD_WRITE;
         phy_dq_oe <= 1;
-        phy_dq_out <= word_data_captured[15:0];
+        // phy_dq_out load moved after case (registered dq_sel_* decode, TC-1)
         phy_dqm <= ~word_wstrb_captured[1:0];
 
         // Rolling preload: capture the beat requested by the PREVIOUS
@@ -780,13 +789,13 @@ always @(posedge controller_clk) begin
             word_wr_data_next <= 1;
         pull_inflight <= (wr_burst_remaining >= 4'd2);
 
-        state <= ST_WRITE_3;
+        state_nx = ST_WRITE_3;
     end
     ST_WRITE_3: begin
         dc <= 0;
 
         phy_dq_oe <= 1;
-        phy_dq_out <= word_data_captured[31:16];
+        // phy_dq_out load moved after case (registered dq_sel_* decode, TC-1)
         phy_dqm <= ~word_wstrb_captured[3:2];
 
         if (wr_burst_remaining > 0) begin
@@ -805,12 +814,12 @@ always @(posedge controller_clk) begin
                 // crosses a 16MB bank boundary, that is the bank the
                 // precharge must target, not the new one.
                 nr_prechg_bank <= addr[24:23];
-                state <= ST_WRITE_4_NEWROW;
+                state_nx = ST_WRITE_4_NEWROW;
             end else begin
-                state <= ST_WRITE_2;
+                state_nx = ST_WRITE_2;
             end
         end else begin
-            state <= ST_WRITE_4;
+            state_nx = ST_WRITE_4;
         end
     end
     ST_WRITE_4: begin
@@ -823,7 +832,7 @@ always @(posedge controller_clk) begin
         // ST_WRITE_4_NEWROW issues CMD_PRECHG directly from its own state
         // and keeps the extra cycle.
         if(dc == TIMING_WRITE-1) begin
-            state <= ST_IDLE;
+            state_nx = ST_IDLE;
             word_wr_done <= 1;  // Slave-issued word write committed: pulse so axi_sdram_slave can release bvalid without polling !word_busy across unrelated io_sdram activity (scanout burst_rd, autorefresh, etc.)
         end
     end
@@ -838,7 +847,7 @@ always @(posedge controller_clk) begin
             phy_ba <= nr_prechg_bank;
             row_open_v[trk(nr_prechg_bank)] <= 1'b0;
             dc <= 0;
-            state <= ST_WRITE_4_NR_PRECHG;
+            state_nx = ST_WRITE_4_NR_PRECHG;
         end
     end
     ST_WRITE_4_NR_PRECHG: begin
@@ -852,7 +861,7 @@ always @(posedge controller_clk) begin
             open_row[trk(addr[24:23])] <= addr[22:10];
             open_bank <= addr[24:23];
             dc <= 0;
-            state <= ST_WRITE_4_NR_ACT;
+            state_nx = ST_WRITE_4_NR_ACT;
         end
     end
     ST_WRITE_4_NR_ACT: begin
@@ -870,7 +879,7 @@ always @(posedge controller_clk) begin
                 pull_inflight <= 0;
             end
             phy_dq_oe <= 1;
-            state <= ST_WRITE_2;
+            state_nx = ST_WRITE_2;
         end
     end
 
@@ -889,14 +898,14 @@ always @(posedge controller_clk) begin
         open_row[trk(addr[24:23])] <= addr[22:10];
         open_bank <= addr[24:23];
 
-        state <= ST_READ_1;
+        state_nx = ST_READ_1;
     end
     ST_READ_1: begin
         phy_a[10] <= 1'b0; // no auto precharge
         enable_dq_read_toggle <= 0;
         if(dc == TIMING_ACT_RW-1) begin
             dc <= 0;
-            state <= ST_READ_2;
+            state_nx = ST_READ_2;
         end
     end
     ST_READ_2: begin
@@ -909,7 +918,7 @@ always @(posedge controller_clk) begin
         addr <= addr + 2'd2;  // BL=2: skip 2 half-word addresses per READ
 
         // Always go to ST_READ_3 for second BL=2 data beat
-        state <= ST_READ_3;
+        state_nx = ST_READ_3;
     end
     ST_READ_3: begin
         // Second BL=2 data beat
@@ -918,24 +927,24 @@ always @(posedge controller_clk) begin
         if(length == 0) begin
             // All READs issued, drain pipeline
             read_newrow <= 0;
-            state <= ST_READ_5;
+            state_nx = ST_READ_5;
         end else if(addr[9:0] <= 10'd1) begin
             // Near end of row, need to activate next row
             read_newrow <= 1;
-            state <= ST_READ_5;
+            state_nx = ST_READ_5;
         end else begin
             // More READs needed (burst mode)
-            state <= ST_READ_2;
+            state_nx = ST_READ_2;
         end
     end
     ST_READ_5: begin
-        state <= ST_READ_8;
+        state_nx = ST_READ_8;
     end
     ST_READ_8: begin
-        state <= ST_READ_9;
+        state_nx = ST_READ_9;
     end
     ST_READ_9: begin
-        state <= ST_READ_6;
+        state_nx = ST_READ_6;
     end
     ST_READ_6: begin
         if(!read_newrow && !word_op) enable_data_done <= 1;
@@ -944,7 +953,7 @@ always @(posedge controller_clk) begin
         if(!read_newrow) begin
             // No row crossing: leave row open, return to IDLE
             // (applies to both word and burst reads)
-            state <= ST_IDLE;
+            state_nx = ST_IDLE;
         end else begin
             // Row-crossing: precharge and activate next row.  phy_ba still
             // holds the bank of the row being read (set at dispatch or the
@@ -953,30 +962,30 @@ always @(posedge controller_clk) begin
             cmd <= CMD_PRECHG;
             phy_a[10] <= 0; // only precharge current bank
             row_open_v[trk(phy_ba)] <= 1'b0;
-            state <= ST_READ_7;
+            state_nx = ST_READ_7;
         end
     end
     ST_READ_7: begin
         if(dc == TIMING_PRECHARGE-1) begin
             if(read_newrow)
-                state <= ST_READ_0;
+                state_nx = ST_READ_0;
             else
-                state <= ST_IDLE;
+                state_nx = ST_IDLE;
         end
     end
 
     ST_BURSTWR_0: begin
         phy_a <= addr[22:10]; // A0-A12 column address
         cmd <= CMD_ACT;
-        state <= ST_BURSTWR_1;
+        state_nx = ST_BURSTWR_1;
     end
     ST_BURSTWR_1: begin
         cmd <= CMD_NOP;
-        state <= ST_BURSTWR_2;
+        state_nx = ST_BURSTWR_2;
     end
     ST_BURSTWR_2: begin
         cmd <= CMD_NOP;
-        state <= ST_BURSTWR_3;
+        state_nx = ST_BURSTWR_3;
     end
     ST_BURSTWR_3: begin
         burstwr_ready <= 1;
@@ -986,33 +995,33 @@ always @(posedge controller_clk) begin
             phy_a <= addr[9:0]; // A0-A9 row address
             cmd <= CMD_WRITE;
             phy_dq_oe <= 1;
-            phy_dq_out <= burstwr_data;
+            // phy_dq_out load moved after case (registered dq_sel_* decode, TC-1)
 
             addr <= addr + 1'b1;
         end
         if(burstwr_strobe | burstwr_done) begin
-            state <= ST_BURSTWR_4;
+            state_nx = ST_BURSTWR_4;
         end
     end
     ST_BURSTWR_4: begin
         cmd <= CMD_NOP;
         phy_dqm <= 2'b11;  // Mask unwanted second BL=2 data beat
-        state <= ST_BURSTWR_5;
+        state_nx = ST_BURSTWR_5;
     end
     ST_BURSTWR_5: begin
         cmd <= CMD_PRECHG;
         phy_a[10] <= 0; // only precharge current bank
         phy_dqm <= 2'b00;  // Restore DQM for future operations
         row_open_v[trk(addr[24:23])] <= 1'b0;  // Track bank close (burstwr never crosses banks)
-        state <= ST_BURSTWR_6;
+        state_nx = ST_BURSTWR_6;
     end
     ST_BURSTWR_6: begin
         cmd <= CMD_NOP;
-        state <= ST_BURSTWR_7;
+        state_nx = ST_BURSTWR_7;
     end
     ST_BURSTWR_7: begin
         cmd <= CMD_NOP;
-        state <= ST_IDLE;
+        state_nx = ST_IDLE;
     end
 
 
@@ -1021,11 +1030,11 @@ always @(posedge controller_clk) begin
         // (state==ST_REFRESH_0 this cycle).
         cmd <= CMD_AUTOREF;
         dc <= 0;
-        state <= ST_REFRESH_1;
+        state_nx = ST_REFRESH_1;
     end
     ST_REFRESH_1: begin
         if(dc == TIMING_AUTOREFRESH-1)  begin
-            state <= ST_IDLE;
+            state_nx = ST_IDLE;
         end
     end
 
@@ -1033,7 +1042,7 @@ always @(posedge controller_clk) begin
     // Unencoded state (SEU / marginal state-bit capture): recover instead of
     // parking forever with word_busy stuck high (blank screen + fabric hang).
     // word_busy self-heals at the next dispatch/completion.
-    default: state <= ST_IDLE;
+    default: state_nx = ST_IDLE;
 
     endcase
 
@@ -1079,7 +1088,7 @@ always @(posedge controller_clk) begin
 
     if(~reset_n_s) begin
         // reset
-        state <= ST_RESET;
+        state_nx = ST_RESET;
         refresh_count <= 0;
         refresh_pending <= 3'd0;
         word_rd_queue <= 0;
@@ -1111,6 +1120,21 @@ always @(posedge controller_clk) begin
         req_prechg_bank <= 0;
         nr_prechg_bank <= 0;
     end
+
+    // TC-1: phy_dq_out loads, decoded from registered selects instead of
+    // the 6-bit state compare (removes state->compare->enable levels from
+    // the state->phy_dq_out DDIO path).  Same values, same cycles.
+    if (dq_sel_w2)
+        phy_dq_out <= word_data_captured[15:0];
+    else if (dq_sel_w3)
+        phy_dq_out <= word_data_captured[31:16];
+    else if (dq_sel_bw3 && burstwr_strobe)
+        phy_dq_out <= burstwr_data;
+
+    state      <= state_nx;
+    dq_sel_w2  <= (state_nx == ST_WRITE_2);
+    dq_sel_w3  <= (state_nx == ST_WRITE_3);
+    dq_sel_bw3 <= (state_nx == ST_BURSTWR_3);
 end
 
 assign phy_clk = chip_clk;
