diff --git a/src/fpga/targets/pocket/pal_display_mode_video.v b/src/fpga/targets/pocket/pal_display_mode_video.v
new file mode 100644
index 0000000..09f3a7b
--- /dev/null
+++ b/src/fpga/targets/pocket/pal_display_mode_video.v
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: Apache-2.0
+// Pocket APF Display Mode grayscale adapter, game-local SDLPAL overlay.
+// This is source only until a new runtime bitstream is compiled and verified.
+`default_nettype none
+
+module pal_display_mode_video (
+    input  wire        clk_vid,
+    input  wire        grayscale_request_async,
+    input  wire        request_toggle_async,
+    input  wire        scanout_reset_n,
+    input  wire [23:0] rgb_in,
+    input  wire        de_in,
+    input  wire        skip_in,
+    input  wire        vs_in,
+    input  wire        hs_in,
+    output reg  [23:0] rgb_out = 24'h0,
+    output reg         de_out = 1'b0,
+    output reg         skip_out = 1'b0,
+    output reg         vs_out = 1'b0,
+    output reg         hs_out = 1'b0,
+    output reg         grayscale_applied = 1'b0,
+    output reg         request_ack_toggle = 1'b0
+);
+    // APF notifies are independent of the game's warm reset. Keep this
+    // synchronizer/output stage running while the CPU and scanout reset;
+    // otherwise an early 00B8 could deadlock waiting for Reset Exit.
+    (* async_reg = "true", altera_attribute = "-name SYNCHRONIZER_IDENTIFICATION FORCED_IF_ASYNCHRONOUS" *)
+    reg grayscale_meta = 1'b0;
+    (* async_reg = "true", altera_attribute = "-name SYNCHRONIZER_IDENTIFICATION FORCED_IF_ASYNCHRONOUS" *)
+    reg grayscale_sync = 1'b0;
+    (* async_reg = "true", altera_attribute = "-name SYNCHRONIZER_IDENTIFICATION FORCED_IF_ASYNCHRONOUS" *)
+    reg [2:0] request_sync = 3'b000;
+    reg request_seen = 1'b0;
+    reg pending_valid = 1'b0;
+    reg pending_grayscale = 1'b0;
+    reg pending_toggle = 1'b0;
+    reg grayscale_active = 1'b0;
+    // The bridge holds the bundled payload until this transaction is ACKed.
+    // Three toggle stages vs two payload stages provide settling margin;
+    // capture the stable payload, then apply it on a later frame boundary.
+    wire apply_pending = pending_valid && (!scanout_reset_n || (vs_in && !de_in));
+    wire grayscale_next = apply_pending ? pending_grayscale : grayscale_active;
+
+    // Full-range integer luma approximation, round to nearest:
+    // Y = (77*R + 150*G + 29*B + 128) >> 8.
+    // Explicit 16-bit operands prevent Verilog shift-width truncation.
+    // Coefficients sum to 256: every neutral 0..255 remains exact,
+    // including black=0 and white=255. No RAM or general multiplier.
+    wire [15:0] red   = {8'h00, rgb_in[23:16]};
+    wire [15:0] green = {8'h00, rgb_in[15:8]};
+    wire [15:0] blue  = {8'h00, rgb_in[7:0]};
+    wire [15:0] luma_sum =
+          (red << 6) + (red << 3) + (red << 2) + red
+        + (green << 7) + (green << 4) + (green << 2) + (green << 1)
+        + (blue << 4) + (blue << 3) + (blue << 2) + blue
+        + 16'd128;
+    wire [7:0] luma = luma_sum[15:8];
+
+    always @(posedge clk_vid) begin
+        grayscale_meta <= grayscale_request_async;
+        grayscale_sync <= grayscale_meta;
+        request_sync <= {request_sync[1:0], request_toggle_async};
+        if (request_sync[2] != request_seen) begin
+            request_seen <= request_sync[2];
+            pending_toggle <= request_sync[2];
+            pending_grayscale <= grayscale_sync;
+            pending_valid <= 1'b1;
+        end
+        if (apply_pending) begin
+            pending_valid <= 1'b0;
+            request_ack_toggle <= pending_toggle;
+        end
+
+        // One identical pipeline cycle for pixels and all APF sidebands.
+        // Blanking RGB carries frame/slot commands; NEVER grayscale it.
+        grayscale_active <= grayscale_next;
+        rgb_out <= (grayscale_next && de_in) ? {luma, luma, luma} : rgb_in;
+        de_out <= de_in;
+        skip_out <= skip_in;
+        vs_out <= vs_in;
+        hs_out <= hs_in;
+        // This flag changes on the edge that really changes output pixels.
+        // The bridge synchronizes it back before acknowledging 00B8.
+        grayscale_applied <= grayscale_next;
+    end
+endmodule
+
+`default_nettype wire
